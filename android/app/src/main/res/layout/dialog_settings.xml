<?xml version="1.0" encoding="utf-8"?>
<!--
  ScrollView dibatasi tinggi (~560dp) lewat FrameLayout pembungkus, karena
  atribut android:maxHeight TIDAK didukung ScrollView -> dulu dialog terpotong
  dan tidak bisa digulir.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<ScrollView
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:overScrollMode="always">

    <LinearLayout
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:tag="dialog">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textStyle="bold"
            android:textSize="16sp"
            android:tag="accent"
            android:paddingBottom="6dp" />

        <!-- ===== TEMA (dropdown, di paling atas agar mudah dijangkau) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tema"
                android:textStyle="bold"
                android:tag="tv" />

            <TextView
                android:id="@+id/themeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeRow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/spinnerThemeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pilih tema"
                android:textSize="14sp"
                android:tag="tv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▾"
                android:textSize="16sp"
                android:tag="muted" />
        </LinearLayout>

        <!-- pratinjau warna tema terpilih -->
        <LinearLayout
            android:id="@+id/themePreview"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Username TikTok -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username TikTok"
            android:textStyle="bold"
            android:tag="tv"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:inputType="text"
                android:hint="contoh: kahfi_live (tanpa @)"
                android:tag="input" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Hubungkan"
                android:textAllCaps="false"
                android:tag="primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Transparansi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transparansi panel"
                android:textStyle="bold"
                android:tag="tv" />

            <TextView
                android:id="@+id/labelOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:tag="muted" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="70"
            android:progress="60" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel gift dan komentar tetap solid."
            android:tag="muted" />

        <!-- Ukuran font -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ukuran font"
                android:textStyle="bold"
                android:tag="tv" />

            <TextView
                android:id="@+id/labelFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14 px"
                android:tag="muted" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="14"
            android:progress="4" />

        <!-- Jenis font -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis font"
            android:textStyle="bold"
            android:tag="tv"
            android:paddingTop="10dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerFont"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Satuan kecepatan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Satuan kecepatan jaringan"
            android:textStyle="bold"
            android:tag="tv"
            android:paddingTop="12dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKbps"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Kbps"
                android:tag="seg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnMbps"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Mbps"
                android:tag="seg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnMBps"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="MBps"
                android:tag="seg"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- Latar belakang / wallpaper -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latar belakang"
            android:textStyle="bold"
            android:tag="tv"
            android:paddingTop="12dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickWallpaper"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="🖼 Pilih Gambar"
                android:textAllCaps="false"
                android:tag="seg"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnClearWallpaper"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Hapus Gambar"
                android:textAllCaps="false"
                android:tag="seg"
                android:stateListAnimator="@null" />
        </LinearLayout>



        <TextView
            android:id="@+id/settingsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Pengaturan disimpan di HP dan juga di server."
            android:tag="muted" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
